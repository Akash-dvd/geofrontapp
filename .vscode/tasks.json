        "cloud",
        "build",
        "apk",
        "--release"
      ],
      "windows": {
        "command": "powershell"
      },
      "linux": {
        "command": "bash",
        "args": ["./scripts/switch_env.sh", "cloud", "build", "apk", "--release"]
