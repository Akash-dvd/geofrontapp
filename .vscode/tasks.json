      "osx": {
        "command": "bash",
        "args": ["./scripts/switch_env.sh", "cloud", "build", "apk", "--release"]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    }
