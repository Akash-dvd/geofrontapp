{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web Debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--web-port=8080"
      ],
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Flutter Web Server (Port 8081)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--web-hostname=0.0.0.0",
        "--web-port=8081"
      ],
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "GeoDraw Package Debug",
      "request": "launch",
      "type": "dart",
      "program": "packages/geodraw/lib/main.dart",
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}"
    }
  ]
}
